# Port the Express backend listens on
PORT=4000

# Base URL of the local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model used for statement analysis
OLLAMA_MODEL=qwen3:8b

# Milliseconds to wait for Ollama before failing the request
OLLAMA_TIMEOUT_MS=180000

# Supabase project URL (Project Settings -> API). Same value as the
# frontend's VITE_SUPABASE_URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase SERVICE ROLE secret key (Project Settings -> API -> service_role).
# Server-side only — never expose this to the frontend/browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Gemini API key, used by POST /api/ai-insight to generate the Financial
# Pattern Overview page's AI insight. Server-side only.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
